// =============================================================================
// Tap In Colegios - Database Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Core Tables
// =============================================================================

model School {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  region    String?
  phone     String?
  email     String?
  logoUrl   String?  @map("logo_url")
  active    Boolean  @default(true)
  config    String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students             Student[]
  cafeterias           Cafeteria[]
  schoolAdmins         SchoolAdmin[]
  preferredByGuardians Guardian[]    @relation("PreferredSchool")

  @@map("schools")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("guardian") // super_admin, school_admin, cafeteria_operator, guardian
  emailVerified Boolean   @default(false) @map("email_verified")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLogin     DateTime? @map("last_login")

  guardian             Guardian?
  refreshTokens        RefreshToken[]
  pushTokens           PushToken[]
  notifications        Notification[]
  schoolAdmin          SchoolAdmin?
  operatedTransactions Transaction[]
  passwordResetTokens  PasswordResetToken[]

  @@index([email])
  @@map("users")
}

model SchoolAdmin {
  id       String @id @default(uuid())
  userId   String @unique @map("user_id")
  schoolId String @map("school_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_admins")
}

model Guardian {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  rut               String?
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  phone             String?
  relationship      String   @default("guardian") // father, mother, guardian, other
  preferredSchoolId String?  @map("preferred_school_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredSchool School?           @relation("PreferredSchool", fields: [preferredSchoolId], references: [id])
  students        GuardianStudent[]
  orders          Order[]
  payments        Payment[]

  @@index([rut])
  @@map("guardians")
}

model Student {
  id                  String   @id @default(uuid())
  schoolId            String   @map("school_id")
  rut                 String   @unique
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  grade               String?
  section             String?
  photoUrl            String?  @map("photo_url")
  fingerprintTemplate Bytes?   @map("fingerprint_template")
  dailyLimit          Int      @default(0) @map("daily_limit")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  school    School            @relation(fields: [schoolId], references: [id])
  guardians GuardianStudent[]
  wallet    Wallet?
  tickets   StudentTicket[]
  orders    Order[]
  payments  Payment[]

  @@index([rut])
  @@index([schoolId])
  @@map("students")
}

model GuardianStudent {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  studentId  String   @map("student_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@map("guardian_students")
}

// =============================================================================
// Cafeteria & Menu
// =============================================================================

model Cafeteria {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  description String?
  active      Boolean  @default(true)
  config      String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school           School                @relation(fields: [schoolId], references: [id])
  menuItems        MenuItem[]
  rechargePackages RechargePackage[]
  transactions     Transaction[]
  orders           Order[]
  menuTemplates    MenuTemplate[]
  weeklyPattern    WeeklyPattern?
  dailyAssignments DailyMenuAssignment[]

  @@map("cafeterias")
}

model MenuItem {
  id                 String   @id @default(uuid())
  cafeteriaId        String   @map("cafeteria_id")
  name               String
  description        String?
  price              Int
  category           String?
  imageUrl           String?  @map("image_url")
  available          Boolean  @default(true)
  availableDays      String   @default("[1,2,3,4,5]") @map("available_days")
  availableTimeSlots String   @default("[\"breakfast\",\"lunch\",\"snack\"]") @map("available_time_slots")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cafeteria       Cafeteria                 @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  templateItems   MenuTemplateItem[]
  patternItems    WeeklyPatternItem[]
  assignmentItems DailyMenuAssignmentItem[]

  @@map("menu_items")
}

// =============================================================================
// Menu Planning System
// =============================================================================

// Template de menu reutilizable (coleccion de platos)
model MenuTemplate {
  id          String   @id @default(uuid())
  cafeteriaId String   @map("cafeteria_id")
  name        String
  description String?
  color       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafeteria Cafeteria          @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  items     MenuTemplateItem[]

  @@map("menu_templates")
}

// Items dentro de un template
model MenuTemplateItem {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  menuItemId String @map("menu_item_id")
  sortOrder  Int    @default(0) @map("sort_order")

  template MenuTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([templateId, menuItemId])
  @@map("menu_template_items")
}

// Patron semanal base (se repite automaticamente)
model WeeklyPattern {
  id          String   @id @default(uuid())
  cafeteriaId String   @unique @map("cafeteria_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafeteria Cafeteria          @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  days      WeeklyPatternDay[]

  @@map("weekly_patterns")
}

// Dias del patron semanal
model WeeklyPatternDay {
  id        String @id @default(uuid())
  patternId String @map("pattern_id")
  dayOfWeek Int    @map("day_of_week") // 1=Lunes, 2=Martes, ..., 5=Viernes

  pattern WeeklyPattern       @relation(fields: [patternId], references: [id], onDelete: Cascade)
  items   WeeklyPatternItem[]

  @@unique([patternId, dayOfWeek])
  @@map("weekly_pattern_days")
}

// Items en un dia del patron semanal
model WeeklyPatternItem {
  id           String @id @default(uuid())
  patternDayId String @map("pattern_day_id")
  menuItemId   String @map("menu_item_id")
  sortOrder    Int    @default(0) @map("sort_order")

  patternDay WeeklyPatternDay @relation(fields: [patternDayId], references: [id], onDelete: Cascade)
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([patternDayId, menuItemId])
  @@map("weekly_pattern_items")
}

// Asignacion de menu a fecha especifica (sobrescribe patron)
model DailyMenuAssignment {
  id          String   @id @default(uuid())
  cafeteriaId String   @map("cafeteria_id")
  date        DateTime
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafeteria Cafeteria                 @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  items     DailyMenuAssignmentItem[]

  @@unique([cafeteriaId, date])
  @@index([date])
  @@map("daily_menu_assignments")
}

// Items en una asignacion diaria
model DailyMenuAssignmentItem {
  id           String @id @default(uuid())
  assignmentId String @map("assignment_id")
  menuItemId   String @map("menu_item_id")
  sortOrder    Int    @default(0) @map("sort_order")

  assignment DailyMenuAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, menuItemId])
  @@map("daily_menu_assignment_items")
}

model RechargePackage {
  id          String   @id @default(uuid())
  cafeteriaId String   @map("cafeteria_id")
  name        String
  description String?
  price       Int
  type        String // ticket, balance
  ticketCount Int?     @map("ticket_count")
  ticketType  String?  @map("ticket_type")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafeteria Cafeteria @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@map("recharge_packages")
}

// =============================================================================
// Wallet & Transactions
// =============================================================================

model Wallet {
  id        String   @id @default(uuid())
  studentId String   @unique @map("student_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  logs         WalletLog[]
  transactions Transaction[]
  payments     Payment[]

  @@index([studentId])
  @@map("wallets")
}

model StudentTicket {
  id         String    @id @default(uuid())
  studentId  String    @map("student_id")
  ticketType String    @map("ticket_type")
  quantity   Int       @default(0)
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_tickets")
}

model WalletLog {
  id            String   @id @default(uuid())
  walletId      String   @map("wallet_id")
  type          String // deposit, purchase, refund, adjustment
  amount        Int
  balanceBefore Int      @map("balance_before")
  balanceAfter  Int      @map("balance_after")
  referenceId   String?  @map("reference_id")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_logs")
}

model Transaction {
  id               String   @id @default(uuid())
  walletId         String   @map("wallet_id")
  cafeteriaId      String   @map("cafeteria_id")
  type             String // purchase, refund, adjustment
  amount           Int
  description      String?
  items            String? // JSON string
  ticketsUsed      String?  @map("tickets_used") // JSON string
  validatedBy      String?  @map("validated_by")
  validationMethod String?  @map("validation_method") // fingerprint, rut_search, qr_code, app_order
  source           String // app, casino
  createdAt        DateTime @default(now()) @map("created_at")

  wallet    Wallet    @relation(fields: [walletId], references: [id])
  cafeteria Cafeteria @relation(fields: [cafeteriaId], references: [id])
  validator User?     @relation(fields: [validatedBy], references: [id])

  @@index([walletId])
  @@map("transactions")
}

// =============================================================================
// Orders
// =============================================================================

model Order {
  id          String   @id @default(uuid())
  guardianId  String   @map("guardian_id")
  studentId   String   @map("student_id")
  cafeteriaId String   @map("cafeteria_id")
  status      String   @default("pending") // pending, confirmed, preparing, ready, delivered, cancelled
  pickupDate  DateTime @map("pickup_date")
  pickupTime  String?  @map("pickup_time")
  items       String // JSON string
  total       Int
  comments    String?
  ticketsUsed String?  @map("tickets_used") // JSON string: {ticketType, quantity}
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guardian  Guardian  @relation(fields: [guardianId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])
  cafeteria Cafeteria @relation(fields: [cafeteriaId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("orders")
}

// =============================================================================
// Payments
// =============================================================================

model Payment {
  id                String    @id @default(uuid())
  guardianId        String    @map("guardian_id")
  studentId         String    @map("student_id")
  walletId          String    @map("wallet_id")
  rechargePackageId String?   @map("recharge_package_id")
  amount            Int
  gateway           String // webpay, flow, fintoc, mock
  gatewayTxId       String?   @map("gateway_tx_id")
  status            String    @default("pending") // pending, processing, completed, failed, refunded
  metadata          String? // JSON string
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  guardian        Guardian         @relation(fields: [guardianId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id])
  wallet          Wallet           @relation(fields: [walletId], references: [id])
  rechargePackage RechargePackage? @relation(fields: [rechargePackageId], references: [id])

  @@index([guardianId])
  @@map("payments")
}

// =============================================================================
// Notifications & Auth
// =============================================================================

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String
  platform  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  data      String? // JSON string
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
