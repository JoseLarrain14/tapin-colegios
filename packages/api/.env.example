# =============================================================================
# Tap In Colegios - API Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# Database (PostgreSQL via Supabase or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tapin_dev?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# =============================================================================
# Production (Railway)
# =============================================================================
# Railway will automatically provide DATABASE_URL when you add PostgreSQL
# Set these in Railway dashboard > Variables:
# - JWT_SECRET (generate a secure random string)
# - ALLOWED_ORIGINS (your Netlify URLs, comma-separated)
# Example: ALLOWED_ORIGINS="https://tapin-admin.netlify.app,https://tapin-app.netlify.app"

# =============================================================================
# Optional Services
# =============================================================================

# Redis (Upstash) - for sessions and rate limiting
# REDIS_URL="redis://default:password@host.upstash.io:6379"

# Supabase
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_KEY="your-service-key"

# Firebase Cloud Messaging (Push Notifications)
# FCM_PROJECT_ID=""
# FCM_PRIVATE_KEY=""
# FCM_CLIENT_EMAIL=""

# Email Service (SendGrid)
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL="noreply@tapincolegios.cl"

# Payment Gateways (for future use)
# WEBPAY_COMMERCE_CODE=""
# WEBPAY_API_KEY=""
# FLOW_API_KEY=""
# FLOW_SECRET_KEY=""
